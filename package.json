{
  "name": "@maveio/data",
  "version": "0.1.2",
  "description": "Video analytics client for mave.io",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "example": "npm run build && node bin/serve_example.js",
    "example:serve": "node bin/serve_example.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "npm run build && npm run typecheck && npm test",
    "release:tag": "node ./bin/release_tag.js",
    "release": "node ./bin/release_tag.js",
    "release:push": "git push origin HEAD --tags"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "mave",
    "video",
    "analytics",
    "metrics",
    "data"
  ],
  "author": "mave.io",
  "license": "MIT",
  "devDependencies": {
    "esbuild-plugin-replace": "^2.0.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maveio/data.git"
  }
}
